---
import { Icon } from "astro-icon/components";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import WidgetLayout from "./WidgetLayout.astro";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
const contentText = (config.content || config.text || "").trim();
const link = config.link;
const hasLink = link && link.enable !== false && link.text && link.url;
const isExternal =
	hasLink &&
	(link.external === true ||
		(/^https?:\/\//i.test(link.url) && link.external !== false));
---

<!-- 组件显示由 sidebarConfig 统一控制；空公告保留板块。 -->
{(
	<WidgetLayout
		name={config.title || i18n(I18nKey.announcement)}
		id="announcement"
		class={className}
		style={style}
	>
		<div class="announcement-wrapper flex flex-col">
			<!-- 公告栏内容 -->
			<div class="announcement-content">
				{contentText}
			</div>

			<!-- 可选链接 -->
			{hasLink && (
				<div class="announcement-actions">
					<div>
						{hasLink && (
							<a
								href={link.url}
								target={isExternal ? "_blank" : "_self"}
								rel={isExternal ? "noopener noreferrer" : undefined}
								class="announcement-btn m3-state-layer"
							>
								<span>{link.text}</span>
								{isExternal && (
									<Icon
										name="material-symbols:arrow-outward-rounded"
										class="announcement-btn__icon"
									/>
								)}
							</a>
						)}
					</div>

				</div>
			)}
		</div>
	</WidgetLayout>
)}

<style lang="stylus">
.announcement-content
	font: var(--m3e-type-body-large)
	font-size: 1.125rem
	color: var(--on-surface-variant)
	line-height: 1.7
	margin: 0
	word-break: break-word
	white-space: pre-line
	overflow-wrap: anywhere

.announcement-actions
	margin-top: var(--m3e-space-3)
	display: flex
	align-items: center
	justify-content: space-between
	gap: var(--m3e-space-3)

.announcement-btn
	display: inline-flex
	align-items: center
	gap: var(--m3e-space-1)
	height: 2rem
	padding: 0 var(--m3e-space-3)
	border-radius: var(--shape-corner-m)
	background: var(--secondary-container)
	color: var(--on-secondary-container)
	font: var(--m3e-type-label-medium)
	font-weight: 500
	text-decoration: none
	--m3e-state-color: var(--on-secondary-container)
	transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)

	&__icon
		width: 1rem
		height: 1rem
		opacity: 0.8

</style>

<script>
	// Migrate old dismissal records without changing the sidebar's page visibility rules.
	function restoreAnnouncement() {
		try {
			localStorage.removeItem("announcementClosed");
			localStorage.removeItem("announcementClosedTime");
		} catch {
			// Storage may be disabled; the announcement should remain visible anyway.
		}
		document.querySelectorAll<HTMLElement>('widget-layout[data-id="announcement"]').forEach(widget => {
			(widget.closest<HTMLElement>(".sidebar-widget") || widget).style.removeProperty("display");
			widget.style.removeProperty("display");
		});
	}
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", restoreAnnouncement, { once: true });
	} else {
		restoreAnnouncement();
	}
	document.addEventListener("swup:content:replace", restoreAnnouncement);
</script>
