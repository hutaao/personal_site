---
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import WidgetLayout from "@components/molecules/WidgetLayout.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { sidebarBuildInfo } from "@utils/sidebar-info";
import { licenseConfig, siteConfig } from "@/config";
import type { SiteInfoWidget } from "@/types/sidebarConfig";
import { Icon } from "astro-icon/components";

interface Props { widget?: SiteInfoWidget; class?: string; style?: string }
const { class: className, style } = Astro.props;
const address = new URL(siteConfig.site);
const platform = address.hostname.endsWith(".github.io") ? "GitHub Pages" : address.hostname;
const buildTime = sidebarBuildInfo.builtAt.toLocaleString(siteConfig.lang.replace("_", "-"), {
	timeZone: siteConfig.timeZone ?? "UTC", year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false,
});
const rows = [
	{ icon: "material-symbols:cloud-outline-rounded", label: i18n(I18nKey.siteInfoPlatform), value: platform },
	{ icon: "material-symbols:rocket-launch-outline-rounded", label: i18n(I18nKey.siteInfoTheme), value: `Shirone v${sidebarBuildInfo.theme}` },
	...(licenseConfig.enable ? [{ icon: "material-symbols:copyright-outline-rounded", label: i18n(I18nKey.siteInfoLicense), value: licenseConfig.name, href: licenseConfig.url }] : []),
];
const details = [
	{ icon: "material-symbols:language-rounded", label: i18n(I18nKey.siteInfoAddress), value: `${address.hostname}${address.pathname}`, href: siteConfig.site, full: true },
	{ icon: "material-symbols:auto-awesome-outline-rounded", label: i18n(I18nKey.siteInfoFramework), value: `v${sidebarBuildInfo.astro}` },
	{ icon: "material-symbols:terminal-rounded", label: i18n(I18nKey.siteInfoNode), value: sidebarBuildInfo.node },
	{ icon: "material-symbols:schedule-rounded", label: i18n(I18nKey.siteInfoBuilt), value: buildTime, full: true },
];
---

<WidgetLayout name={i18n(I18nKey.siteInfo)} id="site-info" class={className} style={style}>
	<ul class="site-info">
		{rows.map((row) => <li class="site-info__row">
			<MetaIcon icon={row.icon} /><span class="site-info__label">{row.label}</span>
			<span class="site-info__rule" aria-hidden="true"></span>
			{row.href ? <a class="site-info__value" href={row.href} target="_blank" rel="noreferrer noopener">{row.value}</a> : <span class="site-info__value">{row.value}</span>}
		</li>)}
	</ul>
	<details class="site-info__more">
		<summary class="site-info__summary m3-state-layer">
			<span class="site-info__open-label">{i18n(I18nKey.siteInfoExpand)}</span>
			<span class="site-info__close-label">{i18n(I18nKey.siteInfoCollapse)}</span>
			<Icon name="material-symbols:keyboard-arrow-down-rounded" aria-hidden="true" />
		</summary>
		<div class="site-info__grid">
			{details.map((item) => <div class:list={["site-info__card", {"site-info__card--full": item.full}]}>
				<Icon name={item.icon} aria-hidden="true" /><span class="site-info__card-label">{item.label}</span>
				{item.href ? <a class="site-info__card-value" href={item.href}>{item.value}</a> : <span class="site-info__card-value">{item.value}</span>}
			</div>)}
		</div>
	</details>
</WidgetLayout>

<style>
.site-info { display: flex; flex-direction: column; gap: var(--m3e-space-2); list-style: none; margin: 0; padding: 0; }
.site-info__row { display: flex; align-items: center; gap: var(--m3e-space-2); }
.site-info__label { font: var(--m3e-type-body-medium); color: var(--on-surface-variant); white-space: nowrap; }
.site-info__rule { flex: 1; min-width: var(--m3e-space-2); border-bottom: 2px dotted var(--outline-variant); }
.site-info__value { font: var(--m3e-type-label-large); color: var(--on-surface); text-align: right; overflow-wrap: anywhere; }
a.site-info__value, a.site-info__card-value { color: var(--primary); text-decoration: none; }
.site-info__more { margin-top: var(--m3e-space-3); }
.site-info__summary { display: flex; justify-content: center; align-items: center; gap: var(--m3e-space-2); min-height: 2.5rem; padding: var(--m3e-space-2); border-radius: var(--shape-corner-m); cursor: pointer; color: var(--primary); font: var(--m3e-type-label-large); list-style: none; }
.site-info__summary::-webkit-details-marker { display: none; }
.site-info__close-label { display: none; }
.site-info__more[open] .site-info__open-label { display: none; }
.site-info__more[open] .site-info__close-label { display: inline; }
.site-info__more[open] summary svg { transform: rotate(180deg); }
.site-info__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--m3e-space-2); margin-top: var(--m3e-space-2); }
.site-info__card { display: grid; grid-template-columns: 1rem minmax(0, 1fr); column-gap: var(--m3e-space-2); padding: var(--m3e-space-3); border-radius: var(--shape-corner-m); background: var(--surface-container-low); }
.site-info__card--full { grid-column: 1 / -1; }
.site-info__card svg { grid-row: 1 / 3; color: var(--primary); font-size: 1rem; }
.site-info__card-label { font: var(--m3e-type-label-small); color: var(--on-surface-variant); }
.site-info__card-value { font: var(--m3e-type-body-small); color: var(--on-surface); overflow-wrap: anywhere; }
</style>
