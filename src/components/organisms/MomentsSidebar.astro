---
import WidgetLayout from "@components/molecules/WidgetLayout.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { getSortedMoments } from "@utils/content-utils";
import { formatInstantDateInSiteTimeZone } from "@utils/content-date";
import { url } from "@utils/url-utils";
import { momentExcerpt } from "@utils/sidebar-text";
import type { MomentsWidget } from "@/types/sidebarConfig";
import { Icon } from "astro-icon/components";

interface Props { widget?: MomentsWidget; class?: string; style?: string }
const { widget, class: className, style } = Astro.props;
const limit = Math.min(10, Math.max(1, Math.floor(widget?.limit ?? 3)));
const moments = (await getSortedMoments()).slice(0, limit);
---

<WidgetLayout name={i18n(I18nKey.moments)} id="sidebar-moments" class={className} style={style}>
	{moments.length === 0 && <p class="sidebar-moments__empty">{i18n(I18nKey.momentsNoResults)}</p>}
	<ul class="sidebar-moments">
		{moments.map((moment) => <li>
			<a class="sidebar-moments__entry m3-state-layer" href={`${url("/moments/")}#moment-${moment.id}`}>
				<div class="sidebar-moments__meta">
					<Icon name="material-symbols:schedule-rounded" aria-hidden="true" />
					<time datetime={moment.published}>{formatInstantDateInSiteTimeZone(new Date(moment.published))}</time>
					{moment.pinned && <Icon name="material-symbols:keep-rounded" class="sidebar-moments__pin" title={i18n(I18nKey.pinned)} />}
				</div>
				<p class="sidebar-moments__excerpt">{momentExcerpt(moment.html) || i18n(I18nKey.momentsImageUpdate)}</p>
			</a>
		</li>)}
	</ul>
	<a class="sidebar-moments__more m3-state-layer" href={url("/moments/")}>
		{i18n(I18nKey.momentsViewAll)}<Icon name="material-symbols:chevron-right-rounded" aria-hidden="true" />
	</a>
</WidgetLayout>

<style>
.sidebar-moments { list-style: none; padding: 0; margin: 0; }
.sidebar-moments__empty { margin:var(--m3e-space-3) 0; text-align:center; color:var(--on-surface-variant); font:var(--m3e-type-body-medium); }
.sidebar-moments li + li { border-top: 1px solid var(--outline-variant); }
.sidebar-moments__entry { display: block; padding: var(--m3e-space-3) var(--m3e-space-2); border-radius: var(--shape-corner-m); color: var(--on-surface-variant); text-decoration: none; }
.sidebar-moments__meta { display: flex; align-items: center; gap: var(--m3e-space-1); color: var(--primary); font: var(--m3e-type-label-medium); }
.sidebar-moments__meta svg { flex-shrink: 0; font-size: 1rem; }
.sidebar-moments__pin { margin-left: auto; }
.sidebar-moments__excerpt { margin: var(--m3e-space-2) 0 0; font: var(--m3e-type-body-medium); display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; overflow-wrap: anywhere; }
.sidebar-moments__more { display: flex; justify-content: center; align-items: center; gap: var(--m3e-space-1); margin-top: var(--m3e-space-2); padding: var(--m3e-space-2); min-height: 2.5rem; border-radius: var(--shape-corner-m); font: var(--m3e-type-label-large); color: var(--primary); text-decoration: none; }
</style>
